rules_version = '2';

// ============================================================
// Firebase Storage Security Rules for Question Hub
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    
    // ========================================================
    // Helper Functions
    // ========================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ========================================================
    // Papers Folder - Public Read, Auth Write
    // ========================================================
    // Allow recursive paths for papers (e.g. papers/subdir/file.pdf)
    match /papers/{allPaths=**} {
      // Anyone can read/download papers
      allow read: if true;
      
      // Only authenticated users can upload
      allow write: if isAuthenticated();
    }

    // ========================================================
    // Temp Folder - Authenticated Write (for bulk upload staging)
    // ========================================================
    match /temp/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
    
    // ========================================================
    // Default Deny
    // ========================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
